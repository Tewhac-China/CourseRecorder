<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nativecam.bridge">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ServerSocket 即使只监听 localhost 也需要 INTERNET 权限 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="NativeCamBridge"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 10+: 前台服务访问相机必须声明 foregroundServiceType="camera",
             否则 openCamera 会报 ERROR_CAMERA_DISABLED (camera error 3) -->
        <service
            android:name=".CameraService"
            android:exported="true"
            android:foregroundServiceType="camera" />
    </application>

</manifest>
